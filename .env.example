# ---- LLM (analysis) ----------------------------------------------------------
# Full free chain: Groq first, then the OpenRouter fallback race.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
# Comma-separated fallback chain of OpenRouter models (defaults shown).
# OPENROUTER_MODELS=nvidia/nemotron-3-super-120b-a12b:free,qwen/qwen3.8-27b:free,nex-agi/nex-n2.5-mini:free,liquid/lfm-2.5-2.6b:free

# Provider mode: unset or "free" uses Groq plus OpenRouter. "openrouter" skips Groq.
# "fixture" replays recorded responses (development only; ignored in production builds).
# LLM_PROVIDER=free

# Public URL, sent to OpenRouter as HTTP-Referer.
# NEXT_PUBLIC_SITE_URL=https://clauseguard.vercel.app

# ---- On-chain sealing (Day 4) -------------------------------------------------
# DEPLOYER_PRIVATE_KEY=   # local deploy command only; throwaway Base Sepolia wallet
# RELAYER_PRIVATE_KEY=   # server-only; throwaway Base Sepolia wallet
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
# NEXT_PUBLIC_REGISTRY_ADDRESS=
